# Product Analytics Chatbot - Environment Variables
# Copy this file to .env and configure your keys.
# NEVER commit .env to version control!

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# LLM Provider Options: "gemini", "anthropic", "openai", "ollama", or "mock"
# Default is "mock" for zero-cost offline testing, switch to "gemini", "anthropic", "openai", or "ollama" for production.
LLM_PROVIDER=mock

# Google Gemini API (Recommended if using Google Cloud / Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (100% On-Premises & Zero External Data Leakage)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Configuration
DATABASE_PATH=data/analytics.duckdb
DATABASE_READ_ONLY=true
QUERY_TIMEOUT_SECONDS=10
QUERY_ROW_LIMIT=1000

# Security Guardrails
ENABLE_SQL_VALIDATION=true
ENFORCE_STRICT_TABLE_WHITELIST=true
AUDIT_LOG_ENABLED=true

